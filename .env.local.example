# Configurações do Supabase para o Controle Financeiro Pessoal
# Obtenha estas credenciais no painel do Supabase: Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Chave de Serviço (Opcional - apenas para scripts administrativos ou webhooks no servidor)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
